---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';

interface NavLink {
	href: string;
	label: string;
}

interface Props {
	title: string;
	description: string;
	tagline?: string;
	navLinks?: NavLink[];
	headTitle?: string;
	type?: 'website' | 'article';
	image?: string;
}

const {
	title,
	description,
	tagline,
	navLinks = [],
	headTitle = title,
	type = 'website',
	image,
} = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={headTitle} description={description} type={type} image={image} />
	</head>
	<body>
		<Header title={title} tagline={tagline} navLinks={navLinks} />
		<main>
			<slot />
		</main>
		<Footer />
	</body>
</html>
